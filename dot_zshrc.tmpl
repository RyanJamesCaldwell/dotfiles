# Shared theme selection for terminal + Neovim + WezTerm.
# Every name below is a full theme: it repaints the prompt, the editor and the
# terminal together. Adding one means adding a Starship TOML under
# dot_config/starship/themes/, a Neovim module under dot_config/nvim/lua/custom/,
# a WezTerm entry in dot_wezterm.lua, and the name here.
THEME_CHOICES=(nightshade aurora abyss rosepine)
THEME_STATE_DIR="$HOME/.config/theme"
THEME_STATE_FILE="$THEME_STATE_DIR/current"
STARSHIP_THEME_DIR="$HOME/.config/starship/themes"

_is_valid_theme() {
  _value_in_list "$1" "${THEME_CHOICES[@]}"
}

if [[ -r "$THEME_STATE_FILE" ]]; then
  export NVIM_THEME="$(<"$THEME_STATE_FILE")"
else
  export NVIM_THEME="$THEME_CHOICES[1]"
fi
# A state file written before a theme was retired still names it, so validate
# before trusting it. Falling back in memory rather than rewriting the file
# leaves the choice intact for any shell that still recognises the name.
_is_valid_theme "$NVIM_THEME" || export NVIM_THEME="$THEME_CHOICES[1]"

# Theme names map one-to-one onto files in $STARSHIP_THEME_DIR. Validating the
# name before building the path keeps a stale or corrupted state file from
# pointing STARSHIP_CONFIG somewhere unexpected.
_set_starship_config_for_theme() {
  local theme_name="$1"
  local config_path="$HOME/.config/starship.toml"

  if _is_valid_theme "$theme_name" && [[ -r "$STARSHIP_THEME_DIR/$theme_name.toml" ]]; then
    config_path="$STARSHIP_THEME_DIR/$theme_name.toml"
  fi

  export STARSHIP_CONFIG="$config_path"
}

_set_starship_config_for_theme "$NVIM_THEME"

_print_theme_usage() {
  echo "Usage: theme <name|current|list|preview|pick>"
  echo "  themes: ${THEME_CHOICES[*]}"
  echo "  each one repaints the prompt, Neovim and WezTerm together"
}

# Picks up a theme change made in another shell or from inside Neovim.
_sync_theme_from_state() {
  local saved="$NVIM_THEME"
  if [[ -r "$THEME_STATE_FILE" ]]; then
    saved="$(<"$THEME_STATE_FILE")"
  fi
  _is_valid_theme "$saved" || saved="$NVIM_THEME"

  if [[ "$saved" != "$NVIM_THEME" ]]; then
    export NVIM_THEME="$saved"
    _set_starship_config_for_theme "$saved"
  fi
}

# Renders every theme's prompt with representative state so they can be
# compared side by side. STARSHIP_SHELL has to name a real shell or Starship
# silently skips custom modules; `sh` also avoids zsh's %{...%} escapes.
_preview_themes() {
  if ! command -v starship >/dev/null 2>&1; then
    echo "starship is not installed; nothing to preview." >&2
    return 1
  fi

  local width=$(( ${COLUMNS:-100} - 4 ))
  (( width < 60 )) && width=60

  local name config_path
  for name in "${THEME_CHOICES[@]}"; do
    config_path="$STARSHIP_THEME_DIR/$name.toml"
    [[ -r "$config_path" ]] || continue
    echo "  $name"
    STARSHIP_SHELL=sh STARSHIP_CONFIG="$config_path" starship prompt \
      --status=0 --cmd-duration=3400 --jobs=0 --terminal-width="$width" 2>/dev/null |
      sed 's/^/  /'
    echo
  done
}

theme() {
  local action="${1:-current}"

  case "$action" in
    current)
      _sync_theme_from_state
      echo "Current theme: $NVIM_THEME"
      [[ $# -eq 0 ]] && _print_theme_usage
      return 0
      ;;
    list|ls)
      printf '%s\n' "${THEME_CHOICES[@]}"
      return 0
      ;;
    preview|demo)
      _preview_themes
      return $?
      ;;
    pick|select)
      local picked
      picked="$(_pick_from_values "Theme" "${THEME_CHOICES[@]}")" || return 1
      [[ -n "$picked" ]] || return 1
      theme "$picked"
      return $?
      ;;
    help|-h|--help)
      echo "Current theme: $NVIM_THEME"
      _print_theme_usage
      return 0
      ;;
  esac

  if ! _is_valid_theme "$action"; then
    echo "Invalid theme: $action" >&2
    echo "Valid themes: ${THEME_CHOICES[*]}" >&2
    return 1
  fi

  export NVIM_THEME="$action"
  _set_starship_config_for_theme "$NVIM_THEME"
  mkdir -p "$THEME_STATE_DIR"
  if ! printf '%s\n' "$action" > "$THEME_STATE_FILE"; then
    echo "Failed to write theme state to $THEME_STATE_FILE" >&2
    return 1
  fi
  echo "Theme set to $action"
}

_is_valid_chezmoi_profile() {
  _value_in_list "$1" "${CHEZMOI_PROFILE_CHOICES[@]}"
}

_print_profile_usage() {
  echo "Usage: profile <personal|work|current|list|pick>"
}

_set_chezmoi_profile() {
  local next="$1"

  if ! _is_valid_chezmoi_profile "$next"; then
    echo "Invalid profile: $next" >&2
    echo "Valid profiles: ${CHEZMOI_PROFILE_CHOICES[*]}" >&2
    return 1
  fi

  if ! printf '%s\n' "$next" > "$HOME/.chezmoi_profile"; then
    echo "Failed to write profile state to $HOME/.chezmoi_profile" >&2
    return 1
  fi

  export CHEZMOI_PROFILE="$next"

  if command -v chezmoi >/dev/null 2>&1; then
    if ! chezmoi apply; then
      _notify_terminal "Chezmoi profile" "Failed to apply profile $next"
      echo "Profile saved as $next, but 'chezmoi apply' failed." >&2
      return 1
    fi
  else
    echo "chezmoi not found; wrote $HOME/.chezmoi_profile but did not apply templates." >&2
  fi

  _notify_terminal "Chezmoi profile" "Profile set to $next"
  echo "Profile set to $next"
}

profile() {
  local action="${1:-current}"

  case "$action" in
    current)
      echo "Current profile: ${CHEZMOI_PROFILE:-unknown}"
      [[ $# -eq 0 ]] && _print_profile_usage
      return 0
      ;;
    list|ls)
      printf '%s\n' "${CHEZMOI_PROFILE_CHOICES[@]}"
      return 0
      ;;
    pick|select)
      local picked
      picked="$(_pick_from_values "Profile" "${CHEZMOI_PROFILE_CHOICES[@]}")" || return 1
      [[ -n "$picked" ]] || return 1
      profile "$picked"
      return $?
      ;;
    help|-h|--help)
      echo "Current profile: ${CHEZMOI_PROFILE:-unknown}"
      _print_profile_usage
      return 0
      ;;
  esac

  _set_chezmoi_profile "$action"
}

